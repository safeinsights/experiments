{
  "name": "SI-Experiments",
  "version": "1.0.0",
  "description": "test various things",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "enclave": "tsx local-enclave/dev-enclave.ts",
    "enclave:test": "vitest run --config local-enclave/vitest.config.ts",
    "enclave:typecheck": "tsc -p local-enclave",
    "enclave:format": "prettier --write local-enclave",
    "pr-report": "tsx pr-report/local.ts",
    "pr-report:test": "vitest run --config pr-report/vitest.config.ts",
    "pr-report:typecheck": "tsc -p pr-report",
    "pr-report:format": "prettier --write pr-report",
    "pr-report:synth": "cd pr-report && cdk synth",
    "pr-report:deploy": "cd pr-report && cdk deploy"
  },
  "author": "SafeInsights",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^2.1.4",
    "@zip.js/zip.js": "^2.7.54",
    "aws-cdk-lib": "^2.278.0",
    "commander": "^12.1.0",
    "constructs": "^10.8.1",
    "express": "^4.21.0",
    "isomorphic-git": "^1.44.18",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "node-fetch": "^3.3.2",
    "tsx": "^4.19.1",
    "vite": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.1149.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
